---
import SocialIcon from './SocialIcon.astro';
import { AUTHOR } from '../data/author';
---

<section class="outro" data-reveal>
  <h2>¿Lista tu terminal?</h2>
  <p>Combina tema, fuente y prompt, y llévate el archivo de configuración en un clic.</p>
  <a class="btn" href="#lab">
    Diseñar la mía
  </a>
</section>

<footer>
  <div class="foot wrap">
    <a class="wordmark" href="#top" aria-label="Volver arriba">
      ~/<b>setups</b>
    </a>
    <p class="keys">
      <span>
        <kbd>Ctrl K</kbd> buscar
      </span>
      <span>
        <kbd>C</kbd> modo CRT
      </span>
      <span>
        <kbd>J</kbd> <kbd>K</kbd> navegar
      </span>
    </p>
    <span class="foot-by">
      Terminales recreadas en HTML y CSS por {AUTHOR.name}
      {AUTHOR.links.map(l => (
        <a
          class="foot-icon"
          href={l.url}
          target="_blank"
          rel="me noopener noreferrer"
          aria-label={`${l.label} de ${AUTHOR.name}`}
        >
          <SocialIcon id={l.id} />
        </a>
      ))}
    </span>
  </div>
</footer>
