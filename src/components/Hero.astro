---
import { THEMES } from '../data/lab';
import { SETUPS } from '../data/setups';
import { DEMO_PROMPTS, DEMO_THEMES, demoCommand, demoLines, themeVars } from '../lib/demo';
import { renderLines } from '../lib/term';

// primer estado de la demo, ya pintado en el HTML (se ve aunque no haya JavaScript)
const first = DEMO_THEMES[0]!;
const lines = renderLines(demoLines(first, DEMO_PROMPTS[0]!, demoCommand(first), true));
---

<script is:inline>
  // entrada: ocultar antes de pintar; si la animación no ha empezado en 3,5 s, mostrarlo todo igualmente
  (function () {
    var d = document.documentElement;
    if (!('animate' in d) || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    d.classList.add('intro');
    window.__introTimer = setTimeout(function () { d.classList.remove('intro'); }, 3500);
  })();
</script>

<section class="hero" id="hero">
  <div class="copy">
    <p class="eyebrow">{SETUPS.length} configuraciones · un laboratorio</p>
    <h1 class="headline" id="title">
      <span class="l"><span class="li">Tu terminal,</span></span>
      <span class="l"><span class="li">con estilo propio.</span></span>
    </h1>
    <p class="subhead">
      Configuraciones reales de kitty, WezTerm, Ghostty y compañía, recreadas en código.
      Elige una, cópiala o diseña la tuya en el laboratorio.
    </p>
    <div class="actions">
      <a class="btn" href="#lab">Abrir el laboratorio</a>
      <a class="btn btn-ghost" href="#indice">Ver las configuraciones</a>
    </div>
    <p class="note">Sin capturas: cada terminal es HTML y CSS.</p>
  </div>

  <figure class="demo" aria-label="Demostración: una terminal que va cambiando de tema">
    <div class="term demo-term" id="demoTerm" style={`${themeVars(first)};--font:'JetBrains Mono', monospace`}>
      <div class="term-bar"><span class="dots"><i></i><i></i><i></i></span><span class="term-title" id="demoTitle">{THEMES[first].name} — zsh</span></div>
      <div class="term-body"><div class="lines" id="demoLines" set:html={lines} /></div>
    </div>
    <figcaption class="demo-themes" id="demoThemes">
      {DEMO_THEMES.map((k, i) => (
        <button data-theme={k} aria-pressed={i === 0} aria-label={`Ver el tema ${THEMES[k].name}`} title={THEMES[k].name}
          style={`--a:${THEMES[k].bg};--b:${THEMES[k].ansi[5]};--c:${THEMES[k].ansi[2]}`}></button>
      ))}
      <a class="demo-lab" href="#lab" id="demoLab">Probar en el laboratorio →</a>
    </figcaption>
  </figure>
</section>
