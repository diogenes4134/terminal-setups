---
// solo se separan con espacio normal las dos frases: es el único punto donde puede partirse la línea
const nb = (s: string) => s.replaceAll(' ', ' ');
const subhead = `${nb('Nueve terminales recreadas en código.')} ${nb('Y un laboratorio para la tuya.')}`;
---

<script is:inline>
  // entrada: ocultar antes de pintar; si la animación no ha empezado en 3,5 s, mostrarlo todo igualmente
  (function () {
    var d = document.documentElement;
    if (!('animate' in d) || !window.matchMedia || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    d.classList.add('intro');
    window.__introTimer = setTimeout(function () { d.classList.remove('intro'); }, 3500);
  })();
</script>

<section class="hero" id="hero">
  <header class="masthead">
    <a class="wordmark" href="#top" aria-label="Terminal Setups, inicio">~/<b>setups</b></a>
    <div class="hairline" aria-hidden="true"></div>
    <nav aria-label="Secciones">
      <a href="#indice" data-spy="indice">Índice</a>
      <a href="#setups" data-spy="setups">Setups</a>
      <a href="#lab" data-spy="lab">Laboratorio</a>
    </nav>
  </header>

  <div class="hero-gap"></div>

  <div class="copy">
    <h1 class="headline" id="title">
      <span class="l"><span class="li">Tu terminal,</span></span>
      <span class="l"><span class="li">con estilo propio.</span></span>
    </h1>
    <p class="subhead">{subhead}</p>
    <a class="btn" href="#lab">Abrir el laboratorio</a>
    <a class="discover" href="#indice">
      Ver las configuraciones
      <svg viewBox="0 0 11 12.6" aria-hidden="true"><path d="M5.5 .4V12M1 7.5L5.5 12L10 7.5" /></svg>
    </a>
  </div>

  <div class="field" aria-hidden="true"><canvas id="horizon"></canvas></div>
</section>
